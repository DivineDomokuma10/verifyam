# Server environment (copy to .env)
DATABASE_URL="file:./dev.db"
PORT=4000
NODE_ENV="development"
COOKIE_NAME="verify_session"
SESSION_TTL_DAYS=30
CORS_ORIGINS="http://localhost:3000"

# CALL-E (https://docs.heycall-e.com)
CALLE_API_KEY=""
CALLE_BASE_URL="https://api.heycall-e.com"
# "true" simulates calls locally (no real calls); "false" dials via CALL-E
CALLE_MOCK="true"
# Mock scenario: verified | warning | inconclusive | no_answer | no_answer_then_verified
CALLE_MOCK_SCENARIO="verified"
# Delay before the mock "call" completes (ms)
CALLE_MOCK_DELAY_MS=15000
# Destination region for calls (NG is International/test-only)
CALLE_REGION="NG"
CALLE_LOCALE="en-NG"
# Public URL of the webhook endpoint (required when CALLE_MOCK=false)
# e.g. https://your-domain.com/api/webhooks/calle or a ngrok/tunnel URL
CALLE_WEBHOOK_URL=""

# Default region used to normalize agent phone numbers to E.164
DEFAULT_PHONE_REGION="NG"

# ---------------------------------------------------------------------------
# Production (Render) — copy these into the service's env vars, NOT into .env
# ---------------------------------------------------------------------------
# NODE_ENV="production"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/verify?sslmode=require"
# CORS_ORIGINS="https://your-client.vercel.app"
# COOKIE_NAME="verify_session"
#
# CALL-E real calls (only when ready — keep CALLE_MOCK="true" on first deploy):
# CALLE_MOCK="false"
# CALLE_API_KEY="..."
# CALLE_WEBHOOK_URL="https://verify-api.onrender.com/api/webhooks/calle"
# CALLE_REGION="US"   # US/SG/MY/IN/AE/AU are local-ready; NG is test-only

{
  "name": "@verify/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/index.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "prisma:generate:prod": "prisma generate --schema prisma/postgresql/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.sqlite.prisma",
    "prisma:migrate:prod": "prisma migrate deploy --schema prisma/postgresql/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@call-e/calle": "^0.6.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.0",
    "express": "^5.1.0",
    "libphonenumber-js": "^1.13.11",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
